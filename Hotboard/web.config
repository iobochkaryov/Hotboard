<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
	<system.webServer>
	  <handlers>
		<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
	  </handlers>
	  <!--
		This web.config is suitable for deploying an ASP.NET Core app to Azure App Service
		via GitHub Actions (Windows). Adjust the arguments value if your assembly name
		is different (e.g. ".\\YourApp.dll").
	  -->
	  <aspNetCore processPath="dotnet" arguments=".\Hotboard.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
	</system.webServer>
  </location>
</configuration>
